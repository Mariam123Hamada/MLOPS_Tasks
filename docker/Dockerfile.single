FROM python:3.11-slim
WORKDIR /app
COPY pyproject.toml ./
COPY src/ ./src/
RUN pip install --no-cache-dir .
RUN useradd --create-home --uid 1000 appuser
COPY --chown=appuser:appuser models/ /app/models/
USER appuser
EXPOSE 8000
CMD ["uvicorn","prodml.api.main:app","--host","0.0.0.0","--port","8000"]
